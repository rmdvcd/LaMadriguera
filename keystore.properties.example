# Configuración de firma para el build de release (NO se commitea: keystore.properties está en .gitignore).
#
# Copia este archivo a `keystore.properties` en la raíz del repo y ajusta los valores,
# o deja que el script lo genere por ti:
#
#   scripts/build-apk.sh --gen-keystore
#
# El archivo `release.keystore` resultante vive solo en tu máquina (o en el secret
# store de CI, en base64). Si falta la firma, `assembleRelease` compila igualmente
# pero deja el APK SIN firmar y lo avisa: un APK sin firmar no se puede instalar.
#
# En CI se pueden usar variables de entorno en lugar de este archivo:
#   KEYSTORE_PATH, KEYSTORE_PASSWORD, KEYSTORE_ALIAS, KEYSTORE_KEY_PASSWORD
# (KEYSTORE_PATH apunta al archivo ya materializado por el workflow).

# Ruta relativa a la raíz del repo (o absoluta).
storeFile=release.keystore
storePassword=CAMBIA_ESTA_PASSWORD
keyAlias=lamadriguera
keyPassword=CAMBIA_ESTA_PASSWORD
