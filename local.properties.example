# Copia este archivo a local.properties y completa los valores.
# local.properties NO se commitea (está en .gitignore).

# Android Studio añade automáticamente sdk.dir al abrir el proyecto.
# Descomenta y ajusta solo si compilas por línea de comandos:
# sdk.dir=/ruta/a/Android/Sdk

# Credenciales de Supabase (Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# Claves públicas X25519 (base64) de custodia del chat cifrado (diseño C).
# Con ellas la app envuelve las MITADES de la clave privada de disputa de cada
# conversación; las privadas correspondientes viven SOLO en el proceso backend
# de disputa (secretos de la Edge Function dispute-decrypt).
# DISPUTE_ADMIN_PUB → custodo: admin general.
# DISPUTE_MODERATOR_PUB → custodo: moderador senior.
# Si se omiten, la app usa el par de DESARROLLO embebido en DisputeKeyConfig
# (cuyas privadas están publicadas a propósito; nunca lo uses en producción).
# DISPUTE_ADMIN_PUB=base64-de-32-bytes
# DISPUTE_MODERATOR_PUB=base64-de-32-bytes

# Moderación de texto (opcional). URL del endpoint de moderación. Si se omite,
# la app llama a la Edge Function Supabase `moderate-text`, cuyos secretos del
# proyecto (MODERATION_PROVIDER=openai|llamaguard|none, MODERATION_API_URL,
# MODERATION_API_KEY) eligen la API de moderación real.
# MODERATION_API_URL=https://tu-proyecto.supabase.co/functions/v1/moderate-text

# NSFW.js en cliente (opcional). URL del bundle de NSFW.js/TensorFlow.js para
# clasificar imágenes ANTES de subirlas. Si se omite, se usa la heurística
# offline de respaldo (ante la duda, la imagen no se sube).
# NSFWJS_MODEL_URL=https://cdn.jsdelivr.net/npm/nsfwjs@2.4.2/dist/nsfwjs.min.js

# ---------------------------------------------------------------------------
# Push con Firebase Cloud Messaging (Fase 8, opcional).
# Firebase console → Configuración del proyecto:
#   FCM_PROJECT_ID  → "ID del proyecto" (p. ej. lamadriguera-push)
#   GOOGLE_API_KEY  → clave de API de la app Android (la de "Predefinida de
#                     Android API key" sirve para FCM).
# Si se omiten, la build NO inicializa Firebase: no hay push y la app usa el
# fallback in-app (user_notifications + Realtime) y el bot opcional de Telegram.
# No hace falta google-services.json: la app se autoconfigura desde BuildConfig.
# ---------------------------------------------------------------------------
# FCM_PROJECT_ID=tu-proyecto-firestore
# GOOGLE_API_KEY=AIza...

# Telegram (solo para el ANUNCIO del canal de releases desde scripts/telegram-announce.sh;
# el bot de avisos individuales vive en los secretos del backend Supabase).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
